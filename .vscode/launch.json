{
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Mock Server (env/dev)",
      "program": "${workspaceFolder}/vue-app/mock-server.js",
      "cwd": "${workspaceFolder}/vue-app",
      "console": "integratedTerminal",
      "runtimeExecutable": "node",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Attach to Lambda (sam local invoke)",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5890
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/lambda/src",
          "remoteRoot": "/var/task"
        }
      ]
    },
    {
      "name": "Debug test_chart.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/lambda/src/test_chart.py",
      "console": "integratedTerminal"
    }
    
  ]
}